{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://career-ops.org/schemas/CandidateCapability.json",
  "title": "CandidateCapability",
  "type": "object",
  "schema_version": "v1.2.0",
  "description": "Candidate verified or inferred capability grounded in primary evidence",
  "properties": {
    "capability_id": {
      "type": "string",
      "minLength": 1
    },
    "concept_id": {
      "type": ["string", "null"]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "depth": {
      "type": ["string", "null"],
      "enum": ["EXPOSURE", "PRACTICAL", "PRODUCTION", "EXPERT", null]
    },
    "years_experience": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "is_verified": {
      "type": "boolean"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_file": {
          "type": "string",
          "enum": ["cv.md", "article-digest.md", "config/profile.yml", "user-stated"]
        },
        "verbatim_quote": {
          "type": "string",
          "minLength": 1
        },
        "source_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "start_char": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "end_char": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      },
      "required": ["source_file", "verbatim_quote", "source_hash"],
      "additionalProperties": false
    },
    "activity": {
      "type": ["string", "null"],
      "description": "Semantic action verb performed (e.g. built, implemented, designed, deployed, maintained)."
    },
    "object": {
      "type": ["string", "null"],
      "description": "Semantic artifact or technical domain acted upon (e.g. REST APIs, RAG pipeline, smart contracts)."
    },
    "skill_concept_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Normalized SkillConcept IDs referenced by this capability."
    },
    "experience_id": {
      "type": ["string", "null"],
      "description": "CandidateExperience context this capability occurred within, if linked."
    },
    "evidence_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "CandidateEvidence items grounding this capability."
    },
    "responsibility_level": {
      "type": "string",
      "enum": [
        "MENTIONED",
        "USED",
        "IMPLEMENTED",
        "DESIGNED",
        "DEPLOYED",
        "OWNED",
        "LED",
        "UNKNOWN"
      ]
    },
    "outcome": {
      "type": ["string", "null"],
      "description": "Explicit source-supported metric, performance result, or quantitative outcome."
    },
    "environment_type": {
      "type": "string",
      "enum": [
        "PRODUCTION",
        "STAGING",
        "TEST_LOCAL",
        "ACADEMIC_STUDY",
        "UNKNOWN"
      ]
    }
  },
  "required": [
    "capability_id",
    "concept_id",
    "name",
    "depth",
    "is_verified",
    "provenance"
  ],
  "additionalProperties": false
}
