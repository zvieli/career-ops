{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://career-ops.org/schemas/CandidateSemanticProfile.json",
  "title": "CandidateSemanticProfile",
  "type": "object",
  "schema_version": "v1.2.0",
  "description": "Canonical semantic profile of candidate grounded in primary user evidence",
  "properties": {
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "verified_yoe": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "verified_yoe_source": {
      "type": ["string", "null"],
      "enum": ["cv.md", "config/profile.yml", "user-stated", null]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "CandidateCapability.json"
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "degree": {
            "type": "string",
            "minLength": 1
          },
          "degree_level": {
            "type": "string",
            "enum": ["BACHELOR", "MASTER", "DOCTORATE", "ASSOCIATE", "CERTIFICATE", "BOOTCAMP", "SECONDARY", "OTHER", "UNKNOWN"]
          },
          "status": {
            "type": ["string", "null"],
            "enum": ["IN_PROGRESS", "COMPLETED", "PAUSED", "UNKNOWN", null]
          },
          "evidence_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "institution": {
            "type": ["string", "null"]
          },
          "gpa": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "gpa_scale": {
            "type": ["string", "null"]
          },
          "is_verified": {
            "type": "boolean"
          },
          "source_file": {
            "type": "string",
            "enum": ["cv.md", "config/profile.yml", "user-stated"]
          },
          "source_quote": {
            "type": "string"
          }
        },
        "required": ["degree", "field", "is_verified", "source_file", "source_quote"],
        "additionalProperties": false
      }
    },
    "legal_eligibility": {
      "type": "object",
      "properties": {
        "work_authorization": {
          "type": ["boolean", "null"]
        },
        "security_clearance": {
          "type": ["boolean", "null"]
        },
        "citizenship": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        },
        "requires_sponsorship": {
          "type": ["boolean", "null"]
        }
      },
      "required": ["work_authorization", "security_clearance", "citizenship"],
      "additionalProperties": false
    },
    "target_roles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "provenance_summary": {
      "type": "object",
      "properties": {
        "cv_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "profile_config_hash": {
          "type": ["string", "null"]
        },
        "article_digest_hash": {
          "type": ["string", "null"]
        }
      },
      "required": ["cv_hash"],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "CandidateEvidence.json" },
      "description": "Atomic source-grounded candidate fact evidence records."
    },
    "experiences": {
      "type": "array",
      "items": { "$ref": "CandidateExperience.json" },
      "description": "Structured candidate experiences (employment, internship, project, academic, etc.)."
    },
    "skills": {
      "type": "array",
      "items": { "$ref": "CandidateSkillEvidence.json" },
      "description": "Candidate technology mentions normalized to shared SkillConcept identity."
    },
    "certifications": {
      "type": "array",
      "items": { "$ref": "CandidateCertification.json" },
      "description": "Explicit professional certifications obtained by the candidate."
    },
    "model_metadata": {
      "type": "object",
      "properties": {
        "model_id": { "type": "string" },
        "prompt_version": { "type": "string" },
        "task_version": { "type": "string" },
        "schema_version": { "type": "string" }
      },
      "required": ["model_id", "prompt_version", "task_version", "schema_version"],
      "additionalProperties": false
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "extraction_ms": { "type": "number" },
        "normalization_ms": { "type": "number" },
        "model_calls": { "type": "number" },
        "normalization_model_calls": { "type": "number" },
        "retries": { "type": "number" },
        "cache_hits": { "type": "number" },
        "cache_misses": { "type": "number" },
        "semantic_resolution_skipped": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "object",
      "properties": {
        "rejected_evidence": { "type": "array" },
        "rejected_experiences": { "type": "array" },
        "rejected_skills": { "type": "array" },
        "rejected_capabilities": { "type": "array" },
        "rejected_education": { "type": "array" },
        "rejected_certifications": { "type": "array" },
        "failure_code": { "type": ["string", "null"] },
        "failure_stage": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "candidate_id",
    "candidate_hash",
    "verified_yoe",
    "verified_yoe_source",
    "capabilities",
    "education",
    "legal_eligibility",
    "target_roles",
    "provenance_summary"
  ],
  "additionalProperties": false
}
